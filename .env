# ═══════════════════════════════════════════════════════════════
# W-MD Bot Server — Environment Variables
# Copy this to `.env` (read automatically, no dotenv needed) or set
# these in your hosting panel. Hosting-panel values win over .env.
# You can also hardcode them in config.js → HARDCODED.
# ═══════════════════════════════════════════════════════════════

# ⚠️ REQUIRED: Your Dashboard ID (copy from dashboard → Settings → Dashboard ID)
DASHBOARD_USER_ID=

# Your WhatsApp number with country code, digits only (e.g. 2567xxxxxxxx)
# Used to auto-request the 8-digit pairing code on first start.
OWNER_NUMBER=

# Pairing mode: code (8-digit, default) | qr | both (code first, QR fallback)
PAIR_MODE=code

# Local API / websocket port (default: 3001)
PORT=3001

# Bot display name
BOT_NAME=W-MD Bot

# Timezone (default: Africa/Kampala)
TIMEZONE=Africa/Kampala

# Sticker metadata
PACK_NAME=W-MD
AUTHOR=W-MD Bot

# Optional: Baileys log level (error | info | debug)
# BAILEYS_LOG_LEVEL=error
